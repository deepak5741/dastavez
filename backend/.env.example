# Postgres connection string. For hosted databases (Neon, Supabase) add ?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/dastavez
PORT=8000
# Comma-separated origins allowed to call the API from a browser. Empty = any.
CORS_ORIGINS=http://localhost:3000
# Long random secret that unlocks /api/admin. Leave empty to turn the admin API off.
ADMIN_TOKEN=
