{
  "tasks": {
    "dev": "deno run --watch --env-file=.env --allow-net --allow-env --allow-read main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "migrate": "deno run --env-file=.env --allow-net --allow-env --allow-read scripts/migrate.ts",
    "seed": "deno run --env-file=.env --allow-net --allow-env --allow-read scripts/seed.ts",
    "setup": "deno task migrate && deno task seed",
    "test": "deno test --env-file=.env --allow-net --allow-env --allow-read"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.0",
    "postgres": "npm:postgres@^3.4.4",
    "zod": "npm:zod@^3.23.8",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "fmt": { "lineWidth": 110 },
  "compilerOptions": { "strict": true }
}
